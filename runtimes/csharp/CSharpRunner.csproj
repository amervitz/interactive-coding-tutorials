<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <WasmMainJSPath>worker.js</WasmMainJSPath>
    <WasmBuildNative>false</WasmBuildNative>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
  <!-- Embed the SDK's reference assemblies, not runtime implementation assemblies.
       ResolveReferences supplies the matching targeting-pack paths on every OS. -->
  <Target Name="EmbedCompilerReferences" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.NETCore.App'">
        <LogicalName>refs.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
